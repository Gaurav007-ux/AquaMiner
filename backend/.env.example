# ============================================================
# AquaYantra Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ────────────────────────────────────────────
APP_NAME=AquaYantra
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aquayantra:aquayantra@localhost:5432/aquayantra
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ── Security / JWT ─────────────────────────────────────────
JWT_SECRET=CHANGE-ME-use-a-long-random-string-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# ── File storage ───────────────────────────────────────────
UPLOAD_DIR=uploads
MODEL_DIR=models

# ── Calibration ────────────────────────────────────────────
CALIBRATION_MIN_SAMPLES=100
CALIBRATION_INIT_WINDOW=200
BASELINE_UPDATE_RATE=0.005
BASELINE_FREEZE_ANOMALY_THRESHOLD=3.0
MAX_BASELINE_DRIFT_PER_HOUR=5.0

# ── Anomaly detection ──────────────────────────────────────
ANOMALY_THRESHOLD=0.65
ANOMALY_CONFIRMATION_THRESHOLD=0.75
ANOMALY_WATCH_THRESHOLD=0.45
ANOMALY_MIN_PERSISTENCE_SAMPLES=3
ANOMALY_COOLDOWN_SAMPLES=10

# ── ML ─────────────────────────────────────────────────────
ML_DEFAULT_MODEL_TYPE=isolation_forest
ML_ISOLATION_FOREST_N_ESTIMATORS=200
ML_ISOLATION_FOREST_CONTAMINATION=0.05
ML_MIN_TRAINING_SAMPLES=500

# ── Processing ─────────────────────────────────────────────
ROLLING_WINDOW_SIZE=50
MEDIAN_FILTER_KERNEL=5
EMA_ALPHA=0.1
